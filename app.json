{
  "expo": {
    "name": "P1 Dash",
    "slug": "p1dash",
    "version": "2.0.0",
    "scheme": "p1dash",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111111",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parikshithv.p1dash"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "package": "com.parikshithv.p1dash"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#111111"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ShareTechMono-Regular.ttf",
            "./assets/fonts/ShareTech-Regular.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EC1C0E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a239cbb2-f650-4003-bec4-81c1cc93b470"
      }
    }
  }
}
